# =========================================================
# DXM repository hygiene and security exclusions
# =========================================================

# Android signing material
/android/key.properties
/android/keystore/
*.jks
*.keystore
*.pem
*.p12
*.pfx

# Local Flutter/Android configuration
/android/local.properties
/android/local.properties.*
/android/.gradle/

# DXM historical patch and inspection material
/.dxm_backups/
/.patch_backups/
/inspections/
*_inspection/
*_inspections/
*.tar
*.tar.gz
*.zip

# Temporary source snapshots and diagnostic extracts
*_current.txt
*_full_current.txt
*_latest.txt
*_file_map.txt

# Platform/build residue
/build/
/.dart_tool/
/.flutter-plugins
/.flutter-plugins-dependencies

# DXM historical source copies
*.bak
*.bak_*
*.before_*
*.save

# Old release-alignment snapshots
pubspec.yaml.before_*
android/local.properties.before_*

# Accidental backend source copied into Flutter repository
/app/
/routes/

# Local project snapshots and loose archives
